# Stock Data API Environment Configuration
# Copy this file to config.env and modify the values as needed

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=3
API_RELOAD=false

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Data Configuration
STOCK_DATA_FOLDER=stock_data
MAX_WORKERS=3

# Security
CORS_ORIGINS=["*"]
ALLOW_CREDENTIALS=true

# Database (if using in future)
# DATABASE_URL=sqlite:///./stock_data.db

# Redis (if using caching)
# REDIS_URL=redis://localhost:6379

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# External APIs
# YAHOO_FINANCE_API_KEY=your_api_key_here

# Deployment
DEPLOYMENT_ENV=local
DEPLOYMENT_VERSION=1.0.0

# Cloudflar
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT_URL=https://38a8209afe28d0cfd14e4290d2fcafe6.r2.cloudflarestorage.com/stock-data-fy
CLOUDFLARE_R2_BUCKET_NAME=stock-data-fy
CLOUDFLARE_WORKERS_SCRIPT_NAME=
CLOUDFLARE_KV_NAMESPACE_ID=2720001d8e4241d587c3d224a9104196
CLOUDFLARE_D1_DATABASE_ID=fc89f519-31a0-4c53-b608-700dc988159f

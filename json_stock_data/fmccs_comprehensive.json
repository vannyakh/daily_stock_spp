        {
          "id": "1f20f71f-1552-32b8-ad7d-7ea2899f8428",
          "content": {
            "id": "1f20f71f-1552-32b8-ad7d-7ea2899f8428",
            "contentType": "STORY",
            "title": "Is There Still Value in Freddie Mac After a 219% Surge in 2025?",
            "description": "",

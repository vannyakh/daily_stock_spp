        {
          "id": "b48396e6-b0e4-34b8-a4ec-0d7ae382d26d",
          "content": {
            "id": "b48396e6-b0e4-34b8-a4ec-0d7ae382d26d",
            "contentType": "STORY",
            "title": "3 US Penny Stocks With At Least $3M Market Cap",
            "description": "",

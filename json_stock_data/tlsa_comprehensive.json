        {
          "id": "6e6eccd1-e572-387a-a242-d7c8612cd176",
          "content": {
            "id": "6e6eccd1-e572-387a-a242-d7c8612cd176",
            "contentType": "STORY",
            "title": "Tiziana Life Sciences files annual safety report for intranasal foralumab",

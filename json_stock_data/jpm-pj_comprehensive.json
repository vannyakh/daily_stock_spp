        {
          "id": "49b8372f-ef0b-3e26-904a-35adbcb6f6b2",
          "content": {
            "id": "49b8372f-ef0b-3e26-904a-35adbcb6f6b2",
            "contentType": "STORY",
            "title": "Bosses Are Cutting Costs, Just Not the Private Jet",

        {
          "id": "44228f32-d6cc-3625-8a37-0b9aca534ee1",
          "content": {
            "id": "44228f32-d6cc-3625-8a37-0b9aca534ee1",
            "contentType": "STORY",
            "title": "Stran (SWAG) Q3 2025 Earnings Call Transcript",
            "description": "",

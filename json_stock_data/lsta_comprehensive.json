        {
          "id": "82fd68ac-3619-3ee8-aa72-a50419425903",
          "content": {
            "id": "82fd68ac-3619-3ee8-aa72-a50419425903",
            "contentType": "STORY",
            "title": "Lisata Therapeutics Partners with Catalent on ADC Technology",
            "description": "",

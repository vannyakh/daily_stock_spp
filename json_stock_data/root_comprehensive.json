          "content": {
            "id": "5ba0b1f3-f623-3ce4-b02f-3a45c2462a18",
            "contentType": "STORY",
            "title": "Reassessing Root (ROOT) Valuation After a Strong Year but Recent Three-Month Share Price Pullback",
            "description": "",

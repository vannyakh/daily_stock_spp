        {
          "id": "77ef590d-c0ba-3588-b489-d12ae2e4a6b5",
          "content": {
            "id": "77ef590d-c0ba-3588-b489-d12ae2e4a6b5",
            "contentType": "STORY",
            "title": "The Cult of Kohl\u2019s Cash",
            "description": "",
            "summary": "Kohl\u2019s has gotten a lot wrong in the past year\u2014widely panned store changes, declining sales, an ousted CEO.  For every $50 they spend on qualifying purchases, they earn $10 in Kohl\u2019s Cash, which is just as good as real money as long as they use it on specified dates.  Kohl\u2019s Cash is fast becoming part of popular culture, much the way  Bed Bath & Beyond\u2019s  \u201cBig Blue\u201d oversize 20% off coupons were a touchstone before the retailer filed for bankruptcy.",
            "pubDate": "2025-12-15T10:30:00Z",
            "displayTime": "2025-12-15T10:30:00Z",
            "isHosted": false,

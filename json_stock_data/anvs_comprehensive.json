        {
          "id": "3d18aa1a-89b1-3200-a381-4235bd8a64b8",
          "content": {
            "id": "3d18aa1a-89b1-3200-a381-4235bd8a64b8",
            "contentType": "STORY",
            "title": "Annovis (ANVS) Secures Patent Coverage for Both Forms of Buntanetap",
            "description": "",

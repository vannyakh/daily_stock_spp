        {
          "id": "db911472-c306-38d4-b0ce-390b587fe97f",
          "content": {
            "id": "db911472-c306-38d4-b0ce-390b587fe97f",
            "contentType": "STORY",
            "title": "Verastem (VSTM): Rapid 55.7% Revenue Growth Forecast Challenges Persistent Unprofitability Narrative",
            "description": "",

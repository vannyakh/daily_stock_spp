        {
          "id": "7b84a523-c33e-3348-a5c4-01d186bc41b3",
          "content": {
            "id": "7b84a523-c33e-3348-a5c4-01d186bc41b3",
            "contentType": "STORY",
            "title": "Lexaria releases additional results from Phase 1b study GLP-1-H24-4",

        {
          "id": "42a83aa2-04d7-303d-82ac-49c3c9479fc3",
          "content": {
            "id": "42a83aa2-04d7-303d-82ac-49c3c9479fc3",
            "contentType": "STORY",
            "title": "Why Packaging Corporation of America (PKG) Shares Are Trading Lower Today",
            "description": "",

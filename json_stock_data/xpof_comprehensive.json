        {
          "id": "46b28081-9bb9-3ef9-b250-8760d581880e",
          "content": {
            "id": "46b28081-9bb9-3ef9-b250-8760d581880e",
            "contentType": "STORY",
            "title": "Why Xponential Fitness (XPOF) Stock Is Trading Lower Today",

        {
          "id": "c28df1e1-f54a-3d71-82d9-2f61aba4abf4",
          "content": {
            "id": "c28df1e1-f54a-3d71-82d9-2f61aba4abf4",
            "contentType": "STORY",
            "title": "3 High Growth Stocks With Strong Insider Ownership",
            "description": "",
